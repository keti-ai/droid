# pull ubuntu base image
FROM ubuntu:bionic

# build args
ARG ROBOT_TYPE=${ROBOT_TYPE}
ARG LIBFRANKA_VERSION=${LIBFRANKA_VERSION}
ARG ROBOT_IP=${ROBOT_IP}
ARG NUC_IP=${NUC_IP}
ARG NUC_POLYMETIS_DIR=/app/droid/fairo/polymetis
ARG NUC_ROBOT_CONFIG_DIR=/app/config/${ROBOT_TYPE}
ARG NUC_POLYMETIS_CONFIG_DIR=${NUC_POLYMETIS_DIR}/polymetis/conf

# runtime env vars
ENV ROBOT_TYPE=${ROBOT_TYPE}
ENV LIBFRANKA_VERSION=${LIBFRANKA_VERSION}
ENV ROBOT_IP=${ROBOT_IP}
ENV NUC_IP=${NUC_IP}

# --- 여기부터 기존 base 설치 블록에 ca-certificates 추가 ---
RUN apt-get update && \
    apt-get install -y software-properties-common build-essential sudo git curl wget python3-pip libspdlog-dev \
    libeigen3-dev lsb-release ffmpeg libsm6 libxext6 ca-certificates && \
    update-ca-certificates && \
    apt-get upgrade -y

# install latest cmake version
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /etc/apt/trusted.gpg.d/kitware.gpg >/dev/null && \
    apt-add-repository 'deb https://apt.kitware.com/ubuntu/ bionic main' && \
    apt-get update && \
    apt-get install -y cmake

# copy project code to container
COPY . /app
WORKDIR /app

# install miniconda
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && mkdir /root/.conda \
    && bash Miniconda3-latest-Linux-x86_64.sh -b \
    && rm -f Miniconda3-latest-Linux-x86_64.sh
ENV PATH /root/miniconda3/bin:$PATH

# setup polymetis conda env (mamba 사용 + 재시도)
WORKDIR ${NUC_POLYMETIS_DIR}
# --- accept Anaconda TOS for 'defaults' channels used by environment.yml ---
# --- accept Anaconda TOS for 'defaults' channels used by environment.yml ---
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    conda config --remove-key channels || true && \
    conda config --add channels conda-forge && \
    conda config --add channels defaults && \
    conda config --set channel_priority flexible

# micromamba 설치 (파이썬 무의존, base py 3.13과 충돌 없음)
ENV MAMBA_ROOT_PREFIX=/root/miniconda3
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba && \
    mv bin/micromamba /usr/local/bin/ && rm -rf bin

# polymetis env 생성 및 설치 (micromamba 사용)
WORKDIR ${NUC_POLYMETIS_DIR}
RUN bash -lc 'for i in 1 2 3; do \
      micromamba create -y -n polymetis-local -f ./polymetis/environment.yml && break || (echo "[micromamba retry $i]" && sleep 10); \
    done' && \
    micromamba run -n polymetis-local pip install -e ./polymetis


# 🔧 여기 추가 (패치/빌드 구간은 폴리메티스 소스 트리 기준으로 돌아가야 함)
WORKDIR ${NUC_POLYMETIS_DIR}

RUN conda config --remove-key channels || true && \
    conda config --add channels conda-forge && \
    conda config --add channels defaults



RUN micromamba install -y -n polymetis-local -c conda-forge \
  "protobuf=3.20.*" "libprotobuf=3.20.*" "grpc-cpp<1.60" "abseil-cpp>=202301" "re2" "spdlog>=1.10" \
  "gcc_linux-64=11.*" "gxx_linux-64=11.*" "libstdcxx-ng>=12.2" "pkg-config"

# 이후 RUN 들은 전부 conda env 안에서 실행 (여기서 전환)
SHELL ["micromamba", "run", "-n", "polymetis-local", "/bin/bash", "-c"]

# conda 툴체인을 기본 컴파일러로 고정
ENV CONDA_PREFIX=/root/miniconda3/envs/polymetis-local
ENV ADDR2LINE=/root/miniconda3/envs/polymetis-local/bin/x86_64-conda-linux-gnu-addr2line
ENV AR=/root/miniconda3/envs/polymetis-local/bin/x86_64-conda-linux-gnu-ar
ENV CC=$CONDA_PREFIX/bin/x86_64-conda-linux-gnu-cc
ENV CXX=$CONDA_PREFIX/bin/x86_64-conda-linux-gnu-c++

# protobuf 설치 검증 및 cmake 파일 확인
RUN echo "Checking protobuf libraries:" && \
    ls -la $CONDA_PREFIX/lib/libprotobuf.* && \
    nm -D $CONDA_PREFIX/lib/libprotobuf.so | grep -i "InternalMetadata" || echo "Warning: InternalMetadata symbol not found" && \
    $CONDA_PREFIX/bin/protoc --version && \
    echo "Checking protobuf cmake files:" && \
    find $CONDA_PREFIX -name "*protobuf*.cmake" -type f && \
    ls -la $CONDA_PREFIX/lib/cmake/protobuf/ || echo "protobuf cmake directory not found"

# 🔧 여기서 TORCH_LIB/LD_LIBRARY_PATH 설정
ENV TORCH_LIB=$CONDA_PREFIX/lib/python3.8/site-packages/torch/lib
ENV LD_LIBRARY_PATH=$TORCH_LIB:$CONDA_PREFIX/lib:/usr/local/lib:$LD_LIBRARY_PATH

ENV CPATH=$CONDA_PREFIX/include:$CPATH
ENV LIBRARY_PATH=$CONDA_PREFIX/lib:$LIBRARY_PATH
ENV PKG_CONFIG_PATH=$CONDA_PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH
ENV CXXFLAGS="$CXXFLAGS -I$CONDA_PREFIX/include -include cstddef"
ENV LDFLAGS="$LDFLAGS -L$CONDA_PREFIX/lib -Wl,-rpath,$CONDA_PREFIX/lib"

# --- torch_server_ops.hpp/.cpp 패치: size_t 통일 + <cstddef> 주입 (경로 자동 탐색)
RUN set -euo pipefail; \
    HPP_PATH="$(find polymetis -path '*/torch_isolation/include/torch_server_ops.hpp' | head -n1)"; \
    CPP_PATH="$(find polymetis -path '*/torch_isolation/src/torch_server_ops.cpp'   | head -n1)"; \
    echo "[patch] HPP=${HPP_PATH}"; echo "[patch] CPP=${CPP_PATH}"; \
    test -n "${HPP_PATH}" && test -n "${CPP_PATH}"; \
    sed -i '1i #include <cstddef>' "${HPP_PATH}"; \
    sed -i 's/(char *data, *int /(char *data, size_t /g' "${HPP_PATH}"; \
    sed -i '1i #include <cstddef>' "${CPP_PATH}"; \
    sed -i 's/(char \*data, *int /(char *data, size_t /g' "${CPP_PATH}"


# 클라이언트 실행파일 타깃들에 protobuf/grpc/absl/re2 링크 의존성 주입
RUN bash -euo pipefail <<'PATCH'
for T in franka_panda_client franka_hand_client empty_statistics_client; do
  # 해당 타깃을 add_executable() 하는 CMakeLists 찾기
  F=$(grep -RIl --include=CMakeLists.txt -e "add_executable[[:space:]]*(${T}\b" polymetis || true)
  if [ -n "$F" ]; then
    echo "[patch] $T in $F"
    # 이미 link가 있으면 중복 삽입 방지
    if ! grep -q "target_link_libraries(${T} " "$F"; then
      # add_executable(...) 바로 다음 줄에 target_link_libraries(...) 삽입
      awk -v tgt="$T" '
        $0 ~ "add_executable[[:space:]]*\\(" tgt "\\b" && !done {
          print
          print "target_link_libraries(" tgt " PRIVATE protobuf::libprotobuf gRPC::grpc++ absl::strings re2)"
          done=1
          next
        }
        { print }
      ' "$F" > "$F.new" && mv "$F.new" "$F"
    fi
  fi
done
PATCH

## CMakeLists 직접 수정으로 대체했으므로 sed 기반 수정 제거

# generated_grpc_protos 라이브러리를 정적 라이브러리에서 객체 라이브러리로 변경
# removed: keep generated_grpc_protos as STATIC (no sed applied)
# RUN sed -i 's/add_library(generated_grpc_protos STATIC/add_library(generated_grpc_protos OBJECT/' \
#   /app/droid/fairo/polymetis/polymetis/CMakeLists.txt

# protobuf 링킹 문제 해결을 위한 추가 설정
RUN echo "export LD_LIBRARY_PATH=\$CONDA_PREFIX/lib:\$LD_LIBRARY_PATH" >> /root/.bashrc && \
    echo "export PKG_CONFIG_PATH=\$CONDA_PREFIX/lib/pkgconfig:\$PKG_CONFIG_PATH" >> /root/.bashrc

# build libfranka(0.15.2) and polymetis
RUN ./scripts/build_libfranka.sh 0.15.2 && \
    cmake --build ./polymetis/src/clients/franka_panda_client/third_party/libfranka/build --target install && \
    ldconfig

RUN rm -rf ./polymetis/build && mkdir -p ./polymetis/build && cd ./polymetis/build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_STANDARD=17 \
      -DBUILD_FRANKA=ON \
      -DBUILD_TORCH_ISOLATION=ON \
      -DBUILD_TESTS=OFF -DBUILD_DOCS=OFF \
      -DCMAKE_VERBOSE_MAKEFILE=ON \
      -DFranka_DIR=/usr/local/lib/cmake/Franka \
      -DCMAKE_PREFIX_PATH="$CONDA_PREFIX;/usr/local" \
      -Dprotobuf_DIR=$CONDA_PREFIX/lib/cmake/protobuf \
      -DProtobuf_INCLUDE_DIR="$CONDA_PREFIX/include" \
      -DProtobuf_PROTOC_EXECUTABLE="$CONDA_PREFIX/bin/protoc" \
      -DProtobuf_USE_STATIC_LIBS=OFF \
      -DProtobuf_LIBRARY=$CONDA_PREFIX/lib/libprotobuf.so \
      -DProtobuf_LIBRARIES=$CONDA_PREFIX/lib/libprotobuf.so \
      -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" && \
    \
    # torch 관련 .so들 먼저 ABI 맞춰 빌드
    cmake --build . --target torch_server_ops torchrot torchscript_pinocchio -j"$(nproc)" && \
    cmake --install . && ldconfig && \
    \
    # run_server 빌드 (링크 에러 해결된 상태여야 함)
    # protobuf 링킹 문제 해결을 위해 환경변수와 링커 플래그 설정
    export LDFLAGS="$LDFLAGS -Wl,--no-as-needed" && \
    # 디버깅: CMakeLists.txt 내용 확인
    echo "=== CMakeLists.txt run_server 링킹 부분 ===" && \
    grep -A 5 -B 5 "target_link_libraries(run_server" /app/droid/fairo/polymetis/polymetis/CMakeLists.txt && \
    echo "=== generated_grpc_protos 링킹 부분 ===" && \
    grep -A 5 -B 5 "target_link_libraries(generated_grpc_protos" /app/droid/fairo/polymetis/polymetis/CMakeLists.txt && \
    echo "=== protobuf 라이브러리 심볼 확인 ===" && \
    nm -D $CONDA_PREFIX/lib/libprotobuf.so | grep -i "InternalMetadata" | head -5 && \
    echo "=== 표준 CMake 빌드 사용 (링커에 --no-as-needed 1회 추가) ===" && \
    cmake --build . --target run_server -j"$(nproc)" && \
    install -m 755 ./run_server "$CONDA_PREFIX/bin/run_server" && \
    ldconfig



# set polymetis config files
WORKDIR /app
RUN cp ${NUC_ROBOT_CONFIG_DIR}/franka_hardware.yaml ${NUC_POLYMETIS_CONFIG_DIR}/robot_client/franka_hardware.yaml && \
    cp ${NUC_ROBOT_CONFIG_DIR}/franka_panda.yaml ${NUC_POLYMETIS_CONFIG_DIR}/robot_model/franka_panda.yaml
# Hydra 설정에 서버 바이너리 경로/포트 주입(없으면 추가)
RUN CFG="/app/droid/fairo/polymetis/polymetis/conf/robot_client/franka_hardware.yaml"; \
    grep -Eq 'binary_path:|server_binary:|exec_path:' "$CFG" || \
    printf '\nserver:\n  binary_path: "%s"\n  ip_address: "0.0.0.0"\n  port: 50051\n' "$CONDA_PREFIX/bin/run_server" >> "$CFG" && \
    grep -nE 'binary_path|server_binary|exec_path|ip_address|port' "$CFG" || true


# python environment setup
RUN pip3 install -e . && \
    pip3 install dm-robotics-moma==0.5.0 --no-deps && \
    pip3 install dm-robotics-transformations==0.5.0 --no-deps && \
    pip3 install dm-robotics-agentflow==0.5.0 --no-deps && \
    pip3 install dm-robotics-geometry==0.5.0 --no-deps && \
    pip3 install dm-robotics-manipulation==0.5.0 --no-deps && \
    pip3 install dm-robotics-controllers==0.5.0 --no-deps

# using miniconda instead of anaconda so overwrite sh scripts
RUN find /app/droid/franka -type f -name "launch_*.sh" -exec sed -i 's/anaconda/miniconda/g' {} \;
RUN find /app/scripts/server -type f -name "launch_server.sh" -exec sed -i 's/anaconda/miniconda/g' {} \;

# set absolute paths
RUN find /app/droid/franka -type f -name "launch_*.sh" -exec sed -i 's|~|/root|g' {} \;
RUN find /app/scripts/server -type f -name "launch_server.sh" -exec sed -i 's|~|/root|g' {} \;

# start the server
RUN chmod +x /app/scripts/server/launch_server.sh
ENTRYPOINT ["/app/scripts/server/launch_server.sh"]
